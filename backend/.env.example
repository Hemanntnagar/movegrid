DATABASE_URL=postgresql+asyncpg://movegrid:movegrid@localhost:5432/movegrid
# For local demos without Postgres you can use:
# DATABASE_URL=sqlite+aiosqlite:///./movegrid_local.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JSON array, comma-separated URLs, or a single origin (Render-friendly)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Google Gemini (fitness plan generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
